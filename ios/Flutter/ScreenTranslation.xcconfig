// Standard iOS Run/Profile/Archive configuration. Android and web never include this file.
// Override SCREEN_TRANSLATION_MODE=OFF at the Xcode target or xcodebuild command line
// to disable only the feature; do not replace the complete DART_DEFINES list.
SCREEN_TRANSLATION_MODE = ON

SCREEN_TRANSLATION_INFO_PLIST_ON = Runner/ScreenTranslationLive-Info.plist
SCREEN_TRANSLATION_INFO_PLIST_OFF = Runner/Info.plist
SCREEN_TRANSLATION_SWIFT_FLAGS_ON = SCREEN_TRANSLATION_LIVE SCREEN_TRANSLATION_PIP_MEDIA
SCREEN_TRANSLATION_SWIFT_FLAGS_OFF =
SCREEN_TRANSLATION_DART_DEFINE_ON = U0NSRUVOX1RSQU5TTEFUSU9OX0VOQUJMRUQ9dHJ1ZQ==
SCREEN_TRANSLATION_DART_DEFINE_OFF = U0NSRUVOX1RSQU5TTEFUSU9OX0VOQUJMRUQ9ZmFsc2U=

SCREEN_TRANSLATION_INFO_PLIST = $(SCREEN_TRANSLATION_INFO_PLIST_$(SCREEN_TRANSLATION_MODE))
SCREEN_TRANSLATION_SWIFT_FLAGS = $(SCREEN_TRANSLATION_SWIFT_FLAGS_$(SCREEN_TRANSLATION_MODE))
SCREEN_TRANSLATION_DART_DEFINE = $(SCREEN_TRANSLATION_DART_DEFINE_$(SCREEN_TRANSLATION_MODE))

// Preserve Generated/Sentry/user defines. Replay is off throughout this iOS build,
// including feature-off mode, until native capture masking is independently verified.
DART_DEFINES = $(inherited),$(SCREEN_TRANSLATION_DART_DEFINE),U0VOVFJZX1JFUExBWV9TRVNTSU9OX1NBTVBMRV9SQVRFPTAuMA==,U0VOVFJZX1JFUExBWV9PTl9FUlJPUl9TQU1QTEVfUkFURT0wLjA=
