<?xml version="1.0" encoding="utf-8"?>
<!-- Монохромная иконка для push-уведомлений (Android 5+).
     Только белый цвет и прозрачность — цветные иконки не поддерживаются. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Коробка/посылка: корпус -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M20,7L12,2L4,7L4,17L12,22L20,17Z" />

    <!-- Коробка: горизонтальная полоса (крышка) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:pathData="M4,7L12,12L20,7" />

    <!-- Коробка: вертикальная полоса по центру -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.2"
        android:pathData="M12,12L12,22" />

    <!-- Перевязка по горизонтали (лента) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#00000000"
        android:strokeWidth="0"
        android:pathData="" />
</vector>
